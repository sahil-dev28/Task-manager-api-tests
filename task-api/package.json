{
	"name": "task-api",
	"version": "1.0.0",
	"description": "Task Manager API",
	"type": "module",
	"main": "src/app.ts",
	"scripts": {
		"start": "tsx src/app.ts",
		"dev": "tsx watch src/app.ts",
		"build": "tsdown",
		"start:dist": "node dist/app.mjs",
		"test": "jest",
		"coverage": "jest --coverage",
		"check-types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/tsconfig.json",
		"check": "biome check --write ."
	},
	"dependencies": {
		"cors": "^2.8.6",
		"dotenv": "^18.0.4",
		"express": "^5.2.1",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.6.3",
		"@types/supertest": "^7.2.1",
		"jest": "^30.5.2",
		"supertest": "^7.3.0",
		"ts-jest": "^29.4.14",
		"tsdown": "^0.23.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3"
	}
}
